[bootstrap]
main_collection = /main/main.collectionc
render = /defrend/render/defrend.renderc

[script]
shared_state = 1

[display]
width = 960
height = 640
high_dpi = 1

[android]
input_method = HiddenInputField
package = com.defold.example.basic3d

[project]
title = Basic 3D Project
dependencies#0 = https://github.com/akhleung/defrend/archive/refs/tags/1.6.2.zip
dependencies#1 = https://github.com/defold/extension-imgui/archive/refs/tags/2.14.0.zip

[physics]
type = 3D

[osx]
bundle_identifier = com.defold.example.basic3d

[ios]
bundle_identifier = com.defold.example.basic3d

[html5]
scale_mode = stretch

[graphics]
opengl_version_hint = 42

[shader]
exclude_gles_sm100 = 1

[input]
game_binding = /imgui/bindings/imgui.input_bindingc

